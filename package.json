{
  "name": "nexfetch",
  "version": "0.5.0",
  "description": "NexFetch — a modern universal download manager for desktop",
  "private": true,
  "license": "Apache-2.0",
  "author": "Shubhabrata Ghosh",
  "repository": {
    "type": "git",
    "url": "https://github.com/shubhabrata19/NexFetch.git"
  },
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "check": "npm run typecheck && npm run lint && npm run test",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fetch:win-binaries": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-win-binaries.ps1",
    "build:torrent-helper": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-torrent-helper.ps1",
    "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icons.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:manifest": "node scripts/verify-binaries.mjs --manifest-only",
    "verify:binaries": "node scripts/verify-binaries.mjs",
    "release:checksums": "node scripts/write-release-checksums.mjs",
    "postinstall": "node scripts/ensure-electron.cjs",
    "package": "npm run build && electron-builder --dir",
    "package:win": "npm run build && electron-builder --win",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "png2icons": "^2.0.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.5"
  }
}
